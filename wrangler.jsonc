// RevStar workshop page, served as Workers static assets at presentation.meohealth.com.
// Deploy:  npx wrangler deploy
{
  "name": "meo-revstar-workshop",
  "account_id": "4e08ed6a0d79365d5fa8accc1b0db216",  // "Meo Health" account (meohealth.com DNS lives here)
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // Worker custom domain: Cloudflare creates the DNS record + certificate itself
  "routes": [
    { "pattern": "presentation.meohealth.com", "custom_domain": true }
  ],
  "workers_dev": false
}
